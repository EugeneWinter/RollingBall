  m_Text: "\u0423\u041F\u0420\u0410\u0412\u041B\u0415\u041D\u0418\u0415\r\n\r\nWASD
    / \u0421\u0442\u0440\u0435\u043B\u043A\u0438 \u2014 \u0434\u0432\u0438\u0436\u0435\u043D\u0438\u0435
    \u0448\u0430\u0440\u0430\r\n\u041A\u0430\u043C\u0435\u0440\u0430 \u0441\u043B\u0435\u0434\u0443\u0435\u0442
    \u0437\u0430 \u0438\u0433\u0440\u043E\u043A\u043E\u043C\r\n\r\n\u0421\u041E\u0411\u0418\u0420\u0410\u0419\u0422\u0415
    \u0432\u0441\u0435 \u0436\u0451\u043B\u0442\u044B\u0435 \u043E\u0431\u044A\u0435\u043A\u0442\u044B
    \u0434\u043B\u044F \u043F\u043E\u0431\u0435\u0434\u044B!\r\n\u0418\u0437\u0431\u0435\u0433\u0430\u0439\u0442\u0435
    \u043F\u0430\u0434\u0435\u043D\u0438\u044F \u0437\u0430 \u043A\u0440\u0430\u0439
    \u043F\u043E\u043B\u044F.\r\n\r\n\u0417\u0415\u041B\u0401\u041D\u0410\u042F \u0417\u041E\u041D\u0410
    \u2014 \u0443\u0441\u043A\u043E\u0440\u0435\u043D\u0438\u0435\r\n\u041A\u0420\u0410\u0421\u041D\u0410\u042F
    \u0417\u041E\u041D\u0410 \u2014 \u0437\u0430\u043C\u0435\u0434\u043B\u0435\u043D\u0438\u0435"
